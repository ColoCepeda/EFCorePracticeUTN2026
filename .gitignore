## .NET / Visual Studio standard .gitignore

# Build results
bin/
obj/
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Ww][Ii][Nn]32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Oo]bj/
[Oo]ut/
[Ll]og/
[Ll]ogs/

# Visual Studio cache/options
.vs/
*.user
*.userosscache
*.sln.docstates
*.userprefs

# Rider
.idea/

# VS Code
.vscode/

# NuGet
*.nupkg
*.snupkg
**/[Pp]ackages/*
!**/[Pp]ackages/build/
*.nuget.props
*.nuget.targets

# EF Core migrations working files (mantiene las migraciones versionadas, ignora artefactos)
# (dejar comentado: las migraciones SI se versionan una vez creadas)

# Rider/VS temp
*.suo
*.user
*.userosscache
*.sln.docstates

# OS files
.DS_Store
Thumbs.db

# Secrets
appsettings.*.local.json
*.pfx
